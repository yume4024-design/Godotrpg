# Rejected layer candidates and original full-size renders remain local.
ren/garment_layers_v*/*.blend
ren/garment_layers_v*/*.glb
ren/garment*/**/*.png
ren/garment*/*.png
# Superseded raw UV-index connectivity inventory is not physical topology.
ren/garment_topology/
ren/garment_topology_geometric/topology.json
# Authored repair failures stay local; receipts and budgeted WebP evidence are retained.
ren/authored_garment_20261021/*.blend
