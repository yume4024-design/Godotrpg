**/baseline.blend
ren/face_v1/*.blend
ren/face_v1/*.glb
ren/face_v1/albedo.png
# Rejected rig sources are retained locally with SHA manifests and failure data.
ren/rig_v1/*.blend
ren/rig_v1/*.glb
